---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { getProjects } from "@/utils/getProjects";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const projects = await getProjects();

const featuredProjects = projects.filter(
  project => project.featured
);
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" class="app-layout">
    <section
  id="hero"
  class:list={[
    "pt-8 pb-6",
    "border-b border-border",
    "animate-hero",
  ]}
>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Quiet Commits
      </h1>

      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />

        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Yoo potato people, think of this as my little corner of
        the internet where unfinished thoughts finally get a place to exist. Random late-night ideas, projects, experiments, and whatever else my brain decides to obsess over...they all end up here eventually. So yeah, consider yourself lucky, as you get to see a true
        Shakespeare at work...or don't, do whatever you want. At the end of the day, the only person i truly need to love
        is myself. #selflove
      </p>

      <p class="mt-2">
        Read my blogs or check out my projects. Click on 

        <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          href="https://github.com/Ganesh-Macherla/quiet-commits/blob/main/README.md"
        >
          this awesome hyperlink
        </LinkButton>

        to keep up.
      </p>

      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              Social Links:
            </div>

            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            Featured Posts
          </h2>

          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            Recent Posts
          </h2>

          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && (
                  <Card variant="h3" {...data} />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts

        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

    {
      featuredProjects.length > 0 && (
        <section
          id="featured-projects"
          class="pt-12 pb-6 border-t border-border"
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            Featured Projects
          </h2>

          <div class="mt-6 flex flex-col gap-6">
            {
              featuredProjects.map(project => (
                <a
                  href={project.link}
                  target="_blank"
                  class="rounded-lg border border-border p-5 transition hover:border-accent"
                >
                  <h3 class="text-2xl font-bold">
                    {project.title}
                  </h3>

                  <p class="mt-2 opacity-80">
                    {project.desc}
                  </p>
                </a>
              ))
            }
          </div>

          <div class="my-8 text-center">
            <LinkButton href="/projects/">
              All Projects

              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (
      document.querySelector("#main-content") as HTMLElement
    )?.dataset?.layout;

    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>